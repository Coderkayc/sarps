# Copy this file to ".env" and fill in your own values. Never share ".env".
SECRET_KEY=replace-with-a-long-random-string

DB_USER=sarps
DB_PASSWORD=replace-with-your-mysql-password
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sarps

# Highest CGPA at your university (5.0 or 4.0). Must match your dataset.
CGPA_MAX=5.0

# Set to 1 once the site is served over HTTPS.
SESSION_COOKIE_SECURE=0
INSTITUTION=University of Nigeria, Nsukka
CURRENT_SESSION=2026/2027
CURRENT_SEMESTER=1

# Google sign-in (optional). See README, "Google sign-in".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
